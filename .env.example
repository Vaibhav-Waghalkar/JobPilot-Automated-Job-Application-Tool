# JobPilot Environment Configuration
# Pluggable LLM keys (optional/free tiers supported)
GEMINI_API_KEY=
GROQ_API_KEY=
OLLAMA_BASE_URL=http://localhost:11434

# Application Settings
DATA_DIR=./data
DATABASE_URL=sqlite+aiosqlite:///./data/jobpilot.db
CHROMA_PERSIST_DIR=./data/chroma_db
BROWSER_PROFILE_DIR=./data/browser_profile

# Matching and Form Filler Defaults
DEFAULT_MATCH_THRESHOLD=70
HUMAN_ALERT_TIMEOUT_SECONDS=180
DAILY_APPLICATION_CAP_DEFAULT=25
